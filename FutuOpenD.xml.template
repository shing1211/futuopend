<?xml version="1.0" encoding="utf-8"?>
<!--
  FutuOpenD.xml — Official Configuration Template
  =================================================
  This file is derived from the official FutuOpenD v10.4.6408 release tarball
  published by Futu Securities (富途证券).

  FutuOpenD is proprietary software owned by Futu Network Technology Limited.
  This template is distributed here for convenience as part of the FutuOpenD
  Docker packaging project (shing1211/futuopend), which is an unofficial
  community project not affiliated with or endorsed by Futu Securities.

  Usage: copy this to your secrets directory and fill in your values.
  All values support ${VAR_NAME} environment variable substitution.

  Config reference: https://github.com/shing1211/futuopend/blob/main/docs/configuration.md
  Official docs:    https://openapi.futunn.com/futu-api-doc/
-->
<futu_opend>
  <!-- ── Basic Parameters ──────────────────────────────────────────── -->
  <!-- ip                 : Protocol listening address. Default: 127.0.0.1 -->
  <!--                    : Use 0.0.0.0 to accept connections from any interface -->
  <ip>${FUTU_IP:-127.0.0.1}</ip>

  <!-- api_port           : TCP API listening port. Default: 11111 -->
  <api_port>${FUTU_API_PORT:-11111}</api_port>

  <!-- login_account     : Futu account ID, phone number, or email.
                           Phone format: +86 13800138000 -->
  <login_account>${FUTU_ACCOUNT}</login_account>

  <!-- login_pwd_md5     : Login password as 32-char MD5 hex.
                           Either login_pwd_md5 OR login_pwd is required. -->
  <login_pwd_md5>${FUTU_PWD_MD5}</login_pwd_md5>

  <!-- login_pwd         : Plain-text login password (login_pwd_md5 takes precedence).
                           WARNING: do not use plain-text in production. -->
  <!-- <login_pwd>123456</login_pwd> -->

  <!-- lang              : Language. Options: en (English), chs (Simplified Chinese) -->
  <lang>${FUTU_LANG:-en}</lang>

  <!-- ── Advanced Parameters ──────────────────────────────────────── -->

  <!-- log_level         : Verbosity. Options: no, debug, info, warning, error, fatal -->
  <!--                     During development: debug. In production: info. -->
  <log_level>${FUTU_LOG_LEVEL:-info}</log_level>

  <!-- log_path          : Custom log directory. Leave unset to use the default. -->
  <!-- <log_path>/var/log/futuopend</log_path> -->

  <!-- push_proto_type   : Push protocol format. 0: protobuf, 1: JSON -->
  <push_proto_type>${FUTU_PUSH_PROTO:-0}</push_proto_type>

  <!-- qot_push_frequency : Max subscription push frequency in milliseconds.
                           Candlesticks and timeframes are not throttled.
                           Leave unset for unlimited. -->
  <!-- <qot_push_frequency>1000</qot_push_frequency> -->

  <!-- telnet_ip          : Telnet debug interface bind address. Default: 127.0.0.1 -->
  <!-- <telnet_ip>127.0.0.1</telnet_ip> -->

  <!-- telnet_port       : Telnet debug interface port. -->
  <!-- <telnet_port>22222</telnet_port> -->

  <!-- rsa_private_key   : Path to RSA private key for API encryption.
                           REQUIRED for trading over the network (when ip is 0.0.0.0).
                           NOT needed for quote-only access or local-only (127.0.0.1) use.
                           Generate at: https://www.futunn.com/en/OpenAPI → Manage Key -->
  <rsa_private_key>${FUTU_RSA_KEY}</rsa_private_key>

  <!-- price_reminder_push : Receive price reminder notifications. 0: off, 1: on -->
  <price_reminder_push>${FUTU_PRICE_REMINDER:-1}</price_reminder_push>

  <!-- auto_hold_quote_right : Auto-grab highest quote right after being kicked. 0: off, 1: on -->
  <!--
    When enabled: if another terminal grabs the highest quote right, FutuOpenD
    will try to reclaim it automatically within 10 seconds.
  -->
  <auto_hold_quote_right>1</auto_hold_quote_right>

  <!-- future_trade_api_time_zone : Time zone for futures trading timestamps. Required for futures accounts. -->
  <!--
    UTC:  0  | UTC+1: +1  | ... | UTC+12: +12
    UTC-11: -11 | ... | UTC-1: -1
    Example for Hong Kong: UTC+8
  -->
  <!-- <future_trade_api_time_zone>UTC+8</future_trade_api_time_zone> -->

  <!-- ── WebSocket Parameters ─────────────────────────────────────── -->

  <!-- websocket_ip      : WebSocket bind address. Default: 127.0.0.1 -->
  <!-- <websocket_ip>127.0.0.1</websocket_ip> -->

  <!-- websocket_port    : WebSocket port. Leave unset to disable WebSocket. -->
  <!-- <websocket_port>33333</websocket_port> -->

  <!-- websocket_key_md5 : WebSocket auth key as 32-bit MD5 hex.
                           Used by JavaScript clients to authenticate. -->
  <!-- <websocket_key_md5>14e1b600b1fd579f47433b88e8d85291</websocket_key_md5> -->

  <!-- websocket_private_key : Path to SSL private key for WSS.
                              Must be paired with websocket_cert. Key must have no password. -->
  <!-- <websocket_private_key>/run/secrets/ws_key.pem</websocket_private_key> -->

  <!-- websocket_cert    : Path to SSL certificate for WSS.
                          Must be paired with websocket_private_key. -->
  <!-- <websocket_cert>/run/secrets/ws_cert.pem</websocket_cert> -->

  <!-- ── US Market Protection (Futu US / moomoo US only) ──────────── -->

  <!-- pdt_protection    : Pattern Day Trade Protection. 0: off, 1: on (recommended) -->
  <!--
    When enabled: FutuOpenD blocks orders that would mark your account as a PDT.
    Note: does not guarantee avoidance of PDT status.
    If marked PDT with equity < $25,000, you cannot open new positions.
  -->
  <pdt_protection>1</pdt_protection>

  <!-- dtcall_confirmation : Day-Trading Call Warning. 0: off, 1: on (recommended) -->
  <!--
    When enabled: FutuOpenD blocks orders that would exceed your remaining
    day-trading buying power. If triggered, the DT Call can only be cleared
    by depositing funds.
  -->
  <dtcall_confirmation>1</dtcall_confirmation>
</futu_opend>
