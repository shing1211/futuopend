# Environment variables for futuopend Docker
# Copy this file to .env and fill in your values

# --- Secrets (paths on the HOST machine) ---

# Absolute path to your RSA private key file on the host
RSA_FILE_LOCAL_PATH=/opt/futuopend/secrets/rsa_key.txt

# Absolute path to your FutuOpenD.xml configuration file on the host
FUTU_OPEND_XML_LOCAL_PATH=/opt/futuopend/secrets/FutuOpenD.xml

# --- Container paths (where secrets are mounted inside the container) ---

# Inside-container path for the RSA private key
RSA_FILE_PATH=/run/secrets/rsa_key.txt

# Inside-container path for FutuOpenD.xml
FUTU_OPEND_XML_PATH=/run/secrets/FutuOpenD.xml

# --- Identity (optional — used if Dockerfile is updated to run as non-root) ---

# Host user ID. Find yours with: id <username>
PUID=1000

# Host group ID. Find yours with: id <username>
PGID=1000

# Container timezone (used when Dockerfile is updated to set TZ env)
TZ=Asia/Hong_Kong
