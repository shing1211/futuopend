# Environment variables for futuopend Docker
# Copy this file to .env and fill in your values

# --- Build options ---

# Target architecture: amd64 or arm64
TARGETARCH=amd64

# Platform for multi-arch Docker builds (used by docker buildx)
# Default: amd64. Use arm64 for Raspberry Pi 4/5
PLATFORM=linux/amd64

# --- FutuOpenD configuration (written into FutuOpenD.xml at runtime) ---

# Your Futu account ID, phone number, or email
FUTU_ACCOUNT=your_account_id

# Login password as MD5 hex (32 chars). Generate: python3 -c "import hashlib; print(hashlib.md5(b'your_password').hexdigest())"
FUTU_PWD_MD5=your_md5_hash_here

# Path to RSA private key inside the container (mounted via docker-compose secrets or volume)
FUTU_RSA_KEY=/run/secrets/rsa_key.txt

# Language: en (English) or chs (Simplified Chinese)
FUTU_LANG=en

# Log level: debug, info, warning, error, fatal
FUTU_LOG_LEVEL=info

# --- Secrets (paths on the HOST machine, used by docker-compose.yaml with Docker Secrets) ---

# Absolute path to your RSA private key file on the host (for Swarm mode)
RSA_FILE_LOCAL_PATH=/opt/futuopend/secrets/rsa_key.txt

# Absolute path to your FutuOpenD.xml configuration file on the host (for Swarm mode)
FUTU_OPEND_XML_LOCAL_PATH=/opt/futuopend/secrets/FutuOpenD.xml

# --- Container settings ---

# Container timezone
TZ=Asia/Hong_Kong
