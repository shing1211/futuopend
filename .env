# config the PUID of the docker user, PUID and PGID can be enquired by command: id <user>
PUID=1000
PGID=1000

# set the timezone of your location
TZ=Asia/Hong_Kong

RSA_FILE_LOCAL_PATH=./private-key.txt
FUTU_OPEND_XML_LOCAL_PATH=./FutuOpenD.xml

RSA_FILE_PATH=/bin/private-key.txt
FUTU_OPEND_XML_PATH=/bin/FutuOpenD.xml
