# Ubuntu 24.04 LTS multi-stage build.
# Each (arch) variant is a separate build target.
#
# Usage:
#   docker build --target final .
#   docker buildx build --platform linux/amd64,linux/arm64 --target final .
#

ARG FUTU_OPEND_VER=10.11.7108

FROM ubuntu:26.04@sha256:9559ceb7c21e528e233e8dff26a0fb2682f4094cce06176eeb075d87a22b31de AS base-amd64
FROM ubuntu:26.04@sha256:9559ceb7c21e528e233e8dff26a0fb2682f4094cce06176eeb075d87a22b31de AS base-arm64

# hadolint ignore=DL3006
FROM base-${TARGETARCH:-amd64} AS build
ARG FUTU_OPEND_VER

WORKDIR /tmp
COPY checksums/futuopend-sha256.txt /tmp/futuopend-sha256.txt
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && file="Futu_OpenD_${FUTU_OPEND_VER}_Ubuntu18.04.tar.gz" \
    && grep " ${file}\$" /tmp/futuopend-sha256.txt > /tmp/expected.sha256 \
    && test -s /tmp/expected.sha256 \
    && curl -fsSL "https://softwaredownload.futunn.com/${file}" -o "/tmp/${file}" \
    && sha256sum -c /tmp/expected.sha256 \
    && tar -xzf "/tmp/${file}" \
    && rm "/tmp/${file}"

# hadolint ignore=DL3006
FROM base-${TARGETARCH:-amd64} AS final
ARG FUTU_OPEND_VER

ENV TZ=Asia/Hong_Kong \
    FUTU_OPEND_VER=${FUTU_OPEND_VER}

RUN useradd -m futuopend \
    && mkdir -p /run/secrets \
    && chown futuopend:futuopend /run/secrets \
    && mkdir -p /home/futuopend/.com.futunn.FutuOpenD \
    && chown futuopend:futuopend /home/futuopend/.com.futunn.FutuOpenD

COPY --from=build --chown=futuopend:futuopend \
     /tmp/Futu_OpenD_${FUTU_OPEND_VER}_Ubuntu18.04/Futu_OpenD_${FUTU_OPEND_VER}_Ubuntu18.04/ \
     /usr/local/bin/
COPY --chown=futuopend:futuopend entrypoint.sh /usr/local/bin/entrypoint.sh

RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh \
    && chmod +x /usr/local/bin/FutuOpenD \
    && chmod +x /usr/local/bin/entrypoint.sh

USER futuopend
WORKDIR /home/futuopend
EXPOSE 11111 11112
VOLUME /home/futuopend/.com.futunn.FutuOpenD
# hadolint ignore=DL3025
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -x FutuOpenD || exit 1
CMD ["/usr/local/bin/entrypoint.sh"]
